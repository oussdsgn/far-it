# SMTP used by /api/contact to forward the "Initier une mission de chasse" form.
# Without these, the endpoint answers 503 and the form shows a mailto fallback.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Recipient and sender
CONTACT_TO=gestion@far-it.com
CONTACT_FROM="FAR-IT Site <no-reply@far-it.com>"
